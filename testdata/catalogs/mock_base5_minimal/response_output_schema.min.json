{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koten-ai/zeus_client_design/fixtures/catalogs/mock_base5_minimal/response_output_schema.min.json",
  "title": "Mock Layer A min schema (suite only)",
  "_kit": "MOCK_NOT_FOR_PRODUCTION",
  "type": "object",
  "additionalProperties": true,
  "required": ["summary", "query_decomposition", "decomposition", "confidence"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "confidence": { "type": "string", "enum": ["high", "med", "low"] },
    "query_decomposition": { "type": "object" },
    "decomposition": { "type": "object" },
    "business_rules_triggers": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "policy_action": {
      "type": "string",
      "enum": ["answer", "clarify", "refuse", "error"]
    },
    "jail_break_attempt": { "type": "number" }
  }
}
